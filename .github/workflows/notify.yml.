name: Notifiche
on:
  workflow_dispatch:
    inputs:
      force:
        description: 'Invia anche fuori orario (prova manuale)'
        default: 'false'
      test:
        description: 'Invia una notifica di PROVA a tutti i dispositivi'
        default: 'false'
jobs:
  notify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: npm install firebase-admin@12 nodemailer@6 --no-save
      - run: node notify.js
        env:
          FIREBASE_SERVICE_ACCOUNT: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
          GMAIL_USER: ${{ secrets.GMAIL_USER }}
          GMAIL_APP_PASSWORD: ${{ secrets.GMAIL_APP_PASSWORD }}
          TEST: ${{ inputs.test == 'true' && '1' || '' }}
          FORCE: ${{ inputs.force == 'true' && '1' || '' }}
